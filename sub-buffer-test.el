;;; sub-buffer-test.el --- Prototype checks -*- lexical-binding: t; -*-

(require 'ert)
(require 'sub-buffer)

(ert-deftest sub-buffer-api ()
  "Check authentication, escaping, response handling, and cleanup."
  (let ((sub-buffer-server "https://example.test/music/")
        (sub-buffer-user "a user")
        (sub-buffer--credentials nil)
        (body "{\"subsonic-response\":{\"status\":\"ok\",\"searchResult3\":{\"song\":[{\"id\":\"a/b\",\"title\":\"Piece\",\"artist\":\"Artist\",\"album\":\"Album\"},{\"id\":\"other\",\"title\":\"Piece\",\"artist\":\"Artist\",\"album\":\"Album\"}]}}}")
        (status 200)
        seen response-buffer)
    (cl-letf (((symbol-function 'auth-source-search)
               (lambda (&rest _) (list (list :user sub-buffer-user
                                            :secret (lambda () "sëcret")))))
              ((symbol-function 'url-retrieve-synchronously)
               (lambda (url &rest _)
                 (setq seen url response-buffer (generate-new-buffer " *response*"))
                 (with-current-buffer response-buffer
                   (insert "HTTP/1.1 200 OK\r\n\r\n")
                   (setq-local url-http-response-status status)
                   (setq-local url-http-end-of-headers (point))
                   (insert body))
                 response-buffer)))
      (let* ((candidates (sub-buffer--search "Piece & more"))
             (salt (progn (string-match "[?&]s=\\([^&]+\\)" seen)
                          (match-string 1 seen)))
             (token (md5 (encode-coding-string (concat "sëcret" salt) 'utf-8))))
        (should (= 2 (length candidates)))
        (should-not (equal (caar candidates) (car (cadr candidates))))
        (should (equal "a/b" (alist-get 'id (cdar candidates))))
        (should (string-prefix-p "https://example.test/music/rest/search3?" seen))
        (should (string-match-p "u=a%20user" seen))
        (should (string-match-p "query=Piece%20%26%20more" seen))
        (should (string-match-p (concat "t=" token) seen))
        (should-not (string-match-p "[?&]p=" seen))
        (should-not (buffer-live-p response-buffer)))
      (setq body "{\"subsonic-response\":{\"status\":\"failed\",\"error\":{\"code\":40,\"message\":\"Bad login\"}}}")
      (should-error (sub-buffer--search "Piece") :type 'user-error)
      (should-not (buffer-live-p response-buffer))
      (setq body "not json")
      (should-error (sub-buffer--search "Piece") :type 'user-error)
      (should-not (buffer-live-p response-buffer))
      (setq status 503)
      (should-error (sub-buffer--search "Piece") :type 'user-error)
      (should-not (buffer-live-p response-buffer)))
    (cl-letf (((symbol-function 'url-retrieve-synchronously) (lambda (&rest _) nil)))
      (should-error (sub-buffer--search "Piece") :type 'user-error))))

(ert-deftest sub-buffer-authinfo ()
  "Find authinfo logins by host or URL, prompting only for ambiguous accounts."
  (dolist (machine '("example.test" "https://example.test/music"))
    (dolist (spec '((nil ("listener") "listener")
                    ("listener" ("listener" "other") "listener")
                    (nil ("listener" "other") "other")))
      (let* ((file (make-temp-file "sub-buffer-authinfo-"))
             (auth-sources (list file))
             (auth-source-do-cache nil)
             (sub-buffer-server "https://example.test/music/")
             (sub-buffer-user (car spec))
             (sub-buffer--credentials nil)
             (users (cadr spec))
             (selected (caddr spec))
             (prompts 0))
        (unwind-protect
            (progn
              (with-temp-file file
                (dolist (user users)
                  (insert "machine " machine " login " user " password fixture-" user "\n")))
              (cl-letf (((symbol-function 'read-passwd)
                         (lambda (&rest _) (error "Authinfo lookup fell back to a prompt")))
                        ((symbol-function 'completing-read)
                         (lambda (_prompt collection &rest _)
                           (cl-incf prompts)
                           (should (equal collection users))
                           selected)))
                (should (string-match-p (concat "u=" selected) (sub-buffer--url "ping")))
                (should (equal (nth 2 sub-buffer--credentials) (concat "fixture-" selected)))
                (sub-buffer--url "ping")
                (should (= prompts (if (and (null sub-buffer-user) (cdr users)) 1 0)))
                ;; An explicit account change must discard the cached selection.
                (setq sub-buffer-user "listener")
                (should (string-match-p "u=listener" (sub-buffer--url "ping")))
                (when (cdr users)
                  (let ((credentials sub-buffer--credentials))
                    (cl-letf (((symbol-function 'completing-read)
                               (lambda (&rest _) (signal 'quit nil))))
                      (should (condition-case nil
                                  (progn (sub-buffer-switch-login) nil)
                                (quit t))))
                    (should (eq credentials sub-buffer--credentials))
                    (should (equal sub-buffer-user "listener")))
                  (setq selected "other")
                  (sub-buffer-switch-login)
                  (should (equal sub-buffer-user "other"))
                  (should (equal (nth 2 sub-buffer--credentials) "fixture-other"))
                  (should (string-match-p "u=other" (sub-buffer--url "ping"))))))
          (delete-file file))))))

(ert-deftest sub-buffer-completion-candidate-format ()
  "Keep the base offset in the final cdr, outside the candidate strings."
  (let ((completion-styles '(sub-buffer))
        (labels '("Caparezza — Habemus Capa (Habemus Capa)"
                  "[Album] Caparezza — Habemus Capa" "[Artist] Caparezza")))
    (dotimes (_ 2)
      (let* ((result (completion-all-completions "capa" labels nil 4))
             (tail (last result)))
        (should (eq (cdr tail) 0))
        (setcdr tail nil)
        (should (cl-every #'stringp result))
        (should (equal result labels))))
    (should-not (completion-all-completions "no match" labels nil 8))
    (when (require 'corfu-history nil t)
      (let ((corfu-sort-function #'corfu-history--sort)
            (corfu-history (list (cadr labels)))
            (corfu-history--hash nil))
        (cl-letf (((symbol-function 'sub-buffer--search)
                   (lambda (_) (mapcar (lambda (label) (cons label '((id . "fixture"))))
                                       labels))))
          (with-temp-buffer
            (sub-buffer-mode)
            (insert "capa")
            (let* ((table (nth 2 (sub-buffer--completion-at-point)))
                   (state (corfu--compute '("capa" . 4) table nil))
                   (candidates (alist-get 'corfu--candidates state)))
              (should (= (length candidates) 3))
              (should (cl-every #'stringp candidates)))))))))

(ert-deftest sub-buffer-completion-scrolling ()
  "Restore scrolling after completion, even when it ends in another buffer."
  (dolist (scroll '(t nil current-line))
    (dolist (elsewhere '(nil t))
      (let ((sub-buffer--hscroll-state nil)
            (completion-in-region-mode-predicate #'always))
        (with-temp-buffer
          (sub-buffer-mode)
          (setq-local auto-hscroll-mode scroll)
          (unwind-protect
              (progn
                (completion-in-region-mode 1)
                (should-not auto-hscroll-mode)
                ;; Re-enabling completion must not overwrite the saved setting.
                (completion-in-region-mode 1)
                (if elsewhere
                    (with-temp-buffer (completion-in-region-mode -1))
                  (completion-in-region-mode -1))
                (should (eq auto-hscroll-mode scroll))
                (should-not sub-buffer--hscroll-state))
            (completion-in-region-mode -1)))))))

(ert-deftest sub-buffer-completion-and-references ()
  "Distinguish preview from acceptance and retain links through text edits."
  (let* ((song '((id . "one") (title . "First")))
         (other '((id . "two") (title . "Second")))
         (candidates (sub-buffer--candidates (list song other))))
    (cl-letf (((symbol-function 'sub-buffer--search) (lambda (_) candidates)))
      (with-temp-buffer
        (sub-buffer-mode)
        (buffer-enable-undo)
        (insert "query")
        (let* ((spec (sub-buffer--completion-at-point))
               (exit (plist-get (nthcdr 3 spec) :exit-function)))
          ;; Simulate a frontend inserting an exact candidate but not accepting it.
          (delete-region (point-min) (point-max))
          (insert (caar candidates))
          (funcall exit (caar candidates) 'exact)
          (should-not (sub-buffer--entry))
          (font-lock-ensure)
          (should-not (get-text-property (point-min) 'face))
          (sub-buffer-accept)
          (should (equal (alist-get 'id (cdr (sub-buffer--entry))) "one"))
          (font-lock-ensure)
          (should (eq (get-text-property (point-min) 'face) 'link))
          (should truncate-lines)
          (should (equal (funcall (get-text-property (point-min) 'help-echo)
                                 nil (current-buffer) (point-min))
                         (caar candidates)))
          (let ((entry (sub-buffer--entry)))
            (insert "custom prefix ")
            (end-of-line)
            (insert " custom suffix")
            (goto-char (+ 18 (point-min)))
            (delete-char 1)
            (should (eq entry (sub-buffer--entry)))
            ;; A new query below it must not inherit the reference.
            (sub-buffer-newline)
            (insert "fresh query")
            (should-not (sub-buffer--entry))
            (goto-char (point-min))
            (sub-buffer-edit)
            (should-not (sub-buffer--entry))))
        ;; RET can confirm a selected candidate and then open a fresh draft.
        (erase-buffer)
        (insert "query")
        (sub-buffer--completion-at-point)
        (delete-region (point-min) (point-max))
        (insert (caar candidates))
        (sub-buffer-newline)
        (should-not (sub-buffer--entry))
        (forward-line -1)
        (should (equal (alist-get 'id (cdr (sub-buffer--entry))) "one"))
        ;; Joining two different linked entries must not silently pick a track.
        (erase-buffer)
        (sub-buffer--insert-songs (list song other))
        (goto-char (point-min))
        (end-of-line)
        (undo-boundary)
        (delete-char 1)
        (should-not (sub-buffer--entry))
        (undo-boundary)
        (undo 1)
        (goto-char (point-min))
        (should (equal (alist-get 'id (cdr (sub-buffer--entry))) "one"))))))

(ert-deftest sub-buffer-edit-and-play ()
  "Exercise completion, edits/undo, moved entries, and process lifecycle."
  (let* ((song '((id . "one") (title . "Piece") (artist . "Artist") (album . "Album")))
         (other '((id . "two") (title . "Next") (artist . "Artist") (album . "Album")))
         (emacs (expand-file-name invocation-name invocation-directory))
         (real-make-process (symbol-function 'make-process))
         (exit-code 0)
         commands)
    (cl-letf (((symbol-function 'sub-buffer--request)
               (lambda (&rest _) `((searchResult3 . ((song . (,song)))))))
              ((symbol-function 'sub-buffer--url)
               (lambda (_endpoint params)
                 (concat "https://example.test/stream?id=" (cdr (assoc "id" params)))))
              ((symbol-function 'executable-find) (lambda (_) emacs))
              ((symbol-function 'make-process)
               (lambda (&rest args)
                 (push (plist-get args :command) commands)
                 (apply real-make-process
                        (plist-put args :command
                                   (list emacs "-Q" "--batch" "--eval"
                                         (format "(progn (sleep-for 0.2) (kill-emacs %d))"
                                                 exit-code)))))))
      (with-temp-buffer
        (sub-buffer-mode)
        (buffer-enable-undo)
        (insert "Piece")
        (completion-at-point)
        (goto-char (point-min))
        (should (equal (alist-get 'id (cdr (sub-buffer--entry))) "one"))
        (undo-boundary)
        (let ((entry (sub-buffer--entry)))
          (insert "x")
          (should (eq entry (sub-buffer--entry))))
        (undo-boundary)
        (undo 1)
        (should (sub-buffer--entry))
        (end-of-line)
        (sub-buffer-newline)
        (should-not (get-text-property (point) 'sub-buffer-track))
        (insert "unfinished query\n")
        (sub-buffer--insert "Artist — Next (Album)" other)
        (sub-buffer-newline)
        (goto-char (point-min))
        (sub-buffer-play)
        (let ((first sub-buffer--process))
          (should (string-suffix-p "id=one" (car (last (car commands)))))
          (should (= (marker-position sub-buffer--indicator) (point-min)))
          (should (string-match-p "0:00 / --:--" sub-buffer--status))
          ;; Move the upcoming track above the draft.
          (forward-line 2)
          (sub-buffer-move-up)
          (let ((deadline (+ (float-time) 5)))
            (while (and (eq first sub-buffer--process) (< (float-time) deadline))
              (accept-process-output nil 0.05)))
          (should (equal (alist-get 'id (cdr sub-buffer--current)) "two"))
          (should (string-suffix-p "id=two" (car (last (car commands)))))
          (sub-buffer-stop)
          (accept-process-output nil 0.05)
          (should-not sub-buffer--process)
          (should (= 2 (length commands))))
        ;; Deleting a playing entry retains playback and advances at its old place.
        (goto-char (point-min))
        (sub-buffer-play)
        (sub-buffer-remove)
        (should (equal (alist-get 'id (cdr sub-buffer--current)) "one"))
        (should-not (marker-position sub-buffer--indicator))
        (sub-buffer-next)
        (should (equal (alist-get 'id (cdr sub-buffer--current)) "two"))
        (sub-buffer-stop)
        ;; Failed playback must stop rather than skip through the whole queue.
        (setq exit-code 1)
        (goto-char (point-min))
        (sub-buffer-play)
        (let ((count (length commands))
              (deadline (+ (float-time) 5)))
          (while (and sub-buffer--process (< (float-time) deadline))
            (accept-process-output nil 0.05))
          (should-not sub-buffer--process)
          (should (= count (length commands))))
        ;; A final line without a newline must end the queue, not replay itself.
        (setq exit-code 0)
        (erase-buffer)
        (sub-buffer--insert "First" song)
        (sub-buffer-newline)
        (sub-buffer--insert "Last" other)
        (goto-char (point-min))
        (let ((count (length commands))
              (deadline (+ (float-time) 5)))
          (sub-buffer-play)
          (while (and sub-buffer--process (< (float-time) deadline))
            (accept-process-output nil 0.05))
          (should-not sub-buffer--process)
          (should (= (+ count 2) (length commands))))))))

(ert-deftest sub-buffer-editing-and-collections ()
  "Check editable links, multiword search, and collection insertion."
  (let* ((first '((id . "one") (albumId . "album") (artist . "Artist")
                  (title . "Piece") (album . "Album") (composer . "Composer")))
         (last '((id . "two") (albumId . "album") (artist . "Artist")
                 (title . "Final") (album . "Album")))
         (album `((id . "album") (name . "Album") (artist . "Artist")
                  (song . (,first ,last))))
         (artist `((id . "artist") (name . "Artist") (album . (,album))))
         (playlist '((id . "playlist") (name . "Favourites")))
         (album-buffer nil))
    (cl-letf (((symbol-function 'sub-buffer--request)
               (lambda (endpoint _parameters)
                 (pcase endpoint
                   ("search3" `((searchResult3 . ((song . (,first))
                                                 (album . (,album))
                                                 (artist . (,artist))))))
                   ("getAlbum" `((album . ,album)))
                   ("getArtist" `((artist . ,artist)))
                   ("getPlaylists" `((playlists . ((playlist . (,playlist))))))
                   ("getPlaylist" `((playlist . ((entry . (,last ,first)))))))))
              ((symbol-function 'completing-read)
               (lambda (_prompt candidates &rest _) (caar candidates))))
      (unwind-protect
          (with-temp-buffer
            (sub-buffer-mode)
            (buffer-enable-undo)
            (let ((matches (sub-buffer--search "Artist")))
              (should (= 3 (length matches)))
              (should (= 1 (length (sub-buffer--matches "Piece Composer Artist" matches nil))))
              (should (= 1 (length (sub-buffer--matches "composer piece" matches nil))))
              (let* ((completion-styles '(sub-buffer))
                     (query "composer piece artist")
                     (completed (completion-try-completion query matches nil (length query))))
                (should (string-match-p "Piece" (car completed))))
              (should (= 2 (length (sub-buffer--songs (cdr (cadr matches))))))
              (should (= 2 (length (sub-buffer--songs (cdr (caddr matches)))))))
            ;; Selecting an album through actual completion expands its tracks.
            (cl-letf (((symbol-function 'sub-buffer--search)
                       (lambda (_) (sub-buffer--candidates (list album) 'album))))
              (insert "Artist")
              (completion-at-point)
              (goto-char (point-min))
              (should (equal (alist-get 'id (cdr (sub-buffer--entry))) "one"))
              (forward-line 1)
              (should (equal (alist-get 'id (cdr (sub-buffer--entry))) "two")))
            (erase-buffer)
            (sub-buffer--insert-songs (list first last))
            (goto-char (point-min))
            (let ((entry (sub-buffer--entry)))
              (dolist (position (list (line-beginning-position)
                                     (1+ (line-beginning-position)) (line-end-position)))
                (goto-char position)
                (insert "oops")
                (should (eq entry (sub-buffer--entry))))
              (goto-char (+ 2 (point-min)))
              (sub-buffer-newline)
              (should-not (sub-buffer--entry))
              (insert "draft")
              (goto-char (point-min))
              (should (eq entry (sub-buffer--entry)))
              (sub-buffer-move-down)
              (should (eq entry (sub-buffer--entry)))
              (sub-buffer-move-up)
              (should (eq entry (sub-buffer--entry))))
            ;; Removing and undoing restores the track identity.
            (undo-boundary)
            (sub-buffer-remove)
            (undo-boundary)
            (undo 1)
            (goto-char (point-min))
            (should (sub-buffer--entry))
            ;; Mode restart preserves editable track references.
            (sub-buffer-mode)
            (insert "editable ")
            (should (sub-buffer--entry))
            (undo-boundary)
            (let ((before (buffer-string)) (entry (sub-buffer--entry)))
              (sub-buffer-add-album)
              (goto-char (point-min))
              (should (equal (alist-get 'id (cdr (sub-buffer--entry))) "one"))
              (forward-line 1)
              (should (equal (alist-get 'id (cdr (sub-buffer--entry))) "two"))
              (undo-boundary)
              (undo 1)
              (should (equal before (buffer-string)))
              (goto-char (point-min))
              (should (eq entry (sub-buffer--entry)))
              (cl-letf (((symbol-function 'sub-buffer--album-at-point)
                         (lambda () '((song . nil)))))
                (should-error (sub-buffer-add-album) :type 'user-error)
                (should (equal before (buffer-string)))))
            (sub-buffer-add-album)
            (goto-char (point-min))
            (should (equal (alist-get 'id (cdr (sub-buffer--entry))) "one"))
            (forward-line 1)
            (should (equal (alist-get 'id (cdr (sub-buffer--entry))) "two"))
            (sub-buffer-add-playlist)
            (forward-line -2)
            (should (equal (alist-get 'id (cdr (sub-buffer--entry))) "two"))
            (forward-line 1)
            (should (equal (alist-get 'id (cdr (sub-buffer--entry))) "one"))
            (goto-char (point-min))
            (save-current-buffer (sub-buffer-go-to-album))
            (setq album-buffer (get-buffer "*sub-buffer-album*"))
            (with-current-buffer album-buffer
              (should (derived-mode-p 'sub-buffer-album-mode))
              (should (= 2 (length sub-buffer--album-songs)))
              (sub-buffer-album-add))
            ;; Standard yank preserves references without requiring overrides.
            (goto-char (point-min))
            (sub-buffer-remove)
            (goto-char (point-max))
            (yank)
            (run-hooks 'post-command-hook)
            (forward-line -1)
            (should (sub-buffer--entry))
            (let ((entry (sub-buffer--entry)))
              (insert "oops")
              (should (eq entry (sub-buffer--entry)))))
        (when (buffer-live-p album-buffer) (kill-buffer album-buffer))))))

(ert-deftest sub-buffer-playing-arrow ()
  "Keep the playing marker with its edited entry without changing queue text."
  (with-temp-buffer
    (save-window-excursion
      (switch-to-buffer (current-buffer))
      (sub-buffer-mode)
      (should-not (cdr (window-margins)))
      (should-not header-line-format)
      (should-not buffer-display-table)
      (sub-buffer--insert (make-string 160 ?X) '((id . "playing")))
      (setq sub-buffer--current (sub-buffer--entry))
      (insert "\nNext draft\n")
      (let ((text (buffer-string))
            (tick (buffer-chars-modified-tick)))
        (set-window-hscroll nil 40)
        (sub-buffer--refresh)
        (should (equal text (buffer-string)))
        (should (= tick (buffer-chars-modified-tick))))
      (should (memq 'sub-buffer--indicator overlay-arrow-variable-list))
      (should (= (marker-position sub-buffer--indicator) (point-min)))
      (goto-char (point-min))
      (insert "New draft\n")
      (should (= (marker-position sub-buffer--indicator) (point)))
      (sub-buffer-move-down)
      (should (= (marker-position sub-buffer--indicator) (sub-buffer--current-line)))
      (goto-char sub-buffer--indicator)
      (sub-buffer-remove)
      (should-not (marker-position sub-buffer--indicator))
      (let ((arrow sub-buffer--indicator))
        (sub-buffer-stop)
        (should-not (marker-buffer arrow))
        (should-not sub-buffer--indicator)))))

(ert-deftest sub-buffer-previous-track ()
  "Find the previous track through drafts, moves, and deletion of playback."
  (with-temp-buffer
    (sub-buffer-mode)
    (insert "draft\n")
    (sub-buffer--insert "First" '((id . "one")))
    (insert "\ndraft\n")
    (sub-buffer--insert "Second" '((id . "two")))
    (insert "\n")
    (let ((second (save-excursion (forward-line -1) (sub-buffer--entry))))
      (cl-letf (((symbol-function 'sub-buffer-play)
                 (lambda ()
                   (setq sub-buffer--current (sub-buffer--entry)
                         sub-buffer--position (copy-marker (line-beginning-position) t)))))
        (sub-buffer-previous)
        (should (eq sub-buffer--current second))
        (should (eobp))
        (sub-buffer-previous)
        (should (equal (alist-get 'id (cdr sub-buffer--current)) "one"))
        (should-error (sub-buffer-previous) :type 'user-error)
        ;; Moving the playing entry changes its predecessor.
        (goto-char (sub-buffer--current-line))
        (sub-buffer-move-down)
        (sub-buffer-move-down)
        (sub-buffer-previous)
        (should (eq sub-buffer--current second))
        ;; Deleting it leaves the playback marker at the next remaining line.
        (goto-char (sub-buffer--current-line))
        (sub-buffer-remove)
        (should-error (sub-buffer-previous) :type 'user-error)
        (should (eq sub-buffer--current second))))))

(ert-deftest sub-buffer-seeking ()
  "Send relative seek commands only when the player connection is ready."
  (with-temp-buffer
    (sub-buffer-mode)
    (let (commands)
      (cl-letf (((symbol-function 'process-live-p) (lambda (process) (eq process 'live)))
                ((symbol-function 'sub-buffer--poll) #'ignore)
                ((symbol-function 'sub-buffer--ipc-send)
                 (lambda (command) (push command commands))))
        (should-error (sub-buffer-seek-forward) :type 'user-error)
        (setq sub-buffer--process 'live)
        (should-error (sub-buffer-seek-backward) :type 'user-error)
        (should-not commands)
        (setq sub-buffer--ipc 'live)
        (call-interactively (key-binding (kbd "C-c <right>")))
        (call-interactively (key-binding (kbd "C-c <left>")))
        (should (equal (nreverse commands)
                       '(("seek" 10 "relative+exact") ("seek" -10 "relative+exact"))))))))

(ert-deftest sub-buffer-mpv-progress ()
  "Check actual IPC progress, pause/resume, seeking, arrows, and cleanup."
  (skip-unless (and (executable-find "mpv") (memq system-type '(gnu/linux darwin berkeley-unix))))
  (let ((wav (make-temp-file "sub-buffer-test-" nil ".wav"))
        (real-make-process (symbol-function 'make-process)))
    (unwind-protect
        (progn
          ;; A three-second silent PCM WAV, using only Emacs primitives.
          (cl-labels ((le (value size)
                        (apply #'unibyte-string
                               (cl-loop for shift from 0 below (* size 8) by 8
                                        collect (logand 255 (ash value (- shift)))))))
            (with-temp-buffer
              (set-buffer-multibyte nil)
              (insert "RIFF" (le (+ 36 48000) 4) "WAVEfmt " (le 16 4)
                      (le 1 2) (le 1 2) (le 8000 4) (le 16000 4)
                      (le 2 2) (le 16 2) "data" (le 48000 4) (make-string 48000 0))
              (let ((coding-system-for-write 'no-conversion)) (write-region nil nil wav nil 'silent))))
          (cl-letf (((symbol-function 'sub-buffer--url) (lambda (&rest _) wav))
                    ((symbol-function 'make-process)
                     (lambda (&rest args)
                       (let ((command (plist-get args :command)))
                         (apply real-make-process
                                (plist-put args :command
                                           (append (list (car command) "--no-config" "--ao=null")
                                                   (cdr command))))))))
            (with-temp-buffer
              (sub-buffer-mode)
              (sub-buffer--insert "Silent fixture" '((id . "fixture") (duration . 3)))
              (goto-char (point-min))
              (sub-buffer-play)
              (let ((directory sub-buffer--ipc-directory)
                    (deadline (+ (float-time) 5)))
                (while (and (< sub-buffer--elapsed 0.2) (< (float-time) deadline))
                  (accept-process-output nil 0.05))
                (should (> sub-buffer--elapsed 0.2))
                (should (= (round sub-buffer--duration) 3))
                (should (= (marker-position sub-buffer--indicator) (point-min)))
                (should (string-match-p "/ 0:03" sub-buffer--status))
                (sub-buffer-pause)
                (dotimes (_ 15) (accept-process-output nil 0.05))
                (let ((paused-time sub-buffer--elapsed))
                  (dotimes (_ 15) (accept-process-output nil 0.05))
                  (should sub-buffer--paused)
                  (should (< (abs (- sub-buffer--elapsed paused-time)) 0.05)))
                (let ((paused-time sub-buffer--elapsed))
                  (sub-buffer-seek 1)
                  (dotimes (_ 15) (accept-process-output nil 0.05))
                  ;; Allow for the null audio driver's buffered position.
                  (should (< (abs (- sub-buffer--elapsed paused-time 1)) 0.3))
                  (setq paused-time sub-buffer--elapsed)
                  (sub-buffer-seek -1)
                  (dotimes (_ 15) (accept-process-output nil 0.05))
                  (should (< (abs (- sub-buffer--elapsed paused-time -1)) 0.3))
                  (should sub-buffer--paused))
                (sub-buffer-pause)
                (should-not sub-buffer--paused)
                (sub-buffer-stop)
                (should-not sub-buffer--timer)
                (should-not sub-buffer--indicator)
                (should-not (file-exists-p directory))))))
      (delete-file wav))))

(ert-deftest sub-buffer-optional-keybindings ()
  "Detect active Evil and localleader without loading integration shims."
  (skip-unless (and (require 'evil nil t) (require 'general nil t)))
  (cl-progv '(doom-localleader-key doom-localleader-alt-key)
      '("SPC ," "M-SPC ,")
    (with-temp-buffer
      (sub-buffer-mode)
      (should (eq (key-binding (kbd "RET")) #'sub-buffer-newline))
      (evil-local-mode 1)
      (evil-normal-state)
      (should (eq (key-binding (kbd "RET")) #'sub-buffer-play))
      (should (eq (key-binding (kbd "<")) #'sub-buffer-seek-backward))
      (should (eq (key-binding (kbd ">")) #'sub-buffer-seek-forward))
      (evil-insert-state)
      (should (eq (key-binding (kbd "<")) #'self-insert-command))
      (should (eq (key-binding (kbd ">")) #'self-insert-command))
      (evil-normal-state)
      (should (eq (key-binding (kbd "SPC , a")) #'sub-buffer-search))
      (should (eq (key-binding (kbd "SPC , p")) #'sub-buffer-previous))
      (should (eq (key-binding (kbd "SPC , n")) #'sub-buffer-next))
      (should (eq (key-binding (kbd "SPC , SPC")) #'sub-buffer-pause))
      (should (eq (key-binding (kbd "SPC , l")) #'sub-buffer-add-playlist)))
    (with-temp-buffer
      (sub-buffer-album-mode)
      (evil-local-mode 1)
      (evil-normal-state)
      (should (eq (key-binding (kbd "RET")) #'push-button))
      (should (eq (key-binding (kbd "SPC , a")) #'sub-buffer-album-add)))))

(ert-deftest sub-buffer-evil-editing ()
  "Exercise native Evil keystrokes, registers, label editing, and drafts."
  (skip-unless (require 'evil nil t))
  (let ((evil-undo-system 'undo-redo)
        (evil-undo-function #'undo-only)
        (evil-redo-function #'undo-redo)
        (evil-want-fine-undo t)
        (kill-ring nil)
        played)
    (save-window-excursion
      (with-temp-buffer
        (switch-to-buffer (current-buffer))
        (sub-buffer-mode)
        (buffer-enable-undo)
        (sub-buffer--insert-songs '(((id . "one") (title . "First"))
                                   ((id . "two") (title . "Second"))
                                   ((id . "three") (title . "Third"))))
        (goto-char (point-min))
        (evil-local-mode 1)
        (evil-normal-state)
        (undo-boundary)
        (cl-labels ((ids ()
                      (save-excursion
                        (goto-char (point-min))
                        (let (ids)
                          (while (not (eobp))
                            (when-let* ((entry (sub-buffer--entry)))
                              (push (alist-get 'id (cdr entry)) ids))
                            (forward-line 1))
                          (nreverse ids)))))
          (cl-letf (((symbol-function 'sub-buffer-play)
                     (lambda () (interactive)
                       (setq played (alist-get 'id (cdr (sub-buffer--entry)))))))
            (execute-kbd-macro (kbd "RET"))
            (should (equal played "one")))
          (execute-kbd-macro (kbd "\" a d d"))
          (should (equal (ids) '("two" "three")))
          (should (string-match-p "First" (evil-get-register ?a)))
          (execute-kbd-macro (kbd "\" a p"))
          (should (equal (ids) '("two" "one" "three")))
          (execute-kbd-macro (kbd "u"))
          (should (equal (ids) '("two" "three")))
          (execute-kbd-macro (kbd "C-r"))
          (should (equal (ids) '("two" "one" "three")))
          (execute-kbd-macro (kbd "g g 2 d d"))
          (should (equal (ids) '("three")))
          (execute-kbd-macro (kbd "u"))
          (should (equal (ids) '("two" "one" "three")))
          (execute-kbd-macro (kbd "g g y y P"))
          (should (equal (ids) '("two" "two" "one" "three")))
          (execute-kbd-macro (kbd "g g V j d"))
          (should (equal (ids) '("one" "three")))
          (goto-char (point-min))
          (evil-delete (point) (1+ (point)) 'exclusive)
          (should (equal (ids) '("one" "three")))
          (execute-kbd-macro (kbd "O"))
          (should (evil-insert-state-p))
          (insert "artist query")
          (evil-normal-state)
          (should (equal (ids) '("one" "three")))
          (goto-char (point-min))
          (forward-line 1)
          (execute-kbd-macro (kbd "o"))
          (should (evil-insert-state-p))
          (insert "another query")
          (evil-normal-state)
          (should (equal (ids) '("one" "three")))
          (goto-char (point-min))
          (forward-line 1)
          (execute-kbd-macro (kbd "c c"))
          (should (evil-insert-state-p))
          (insert "replacement query")
          (evil-normal-state)
          (should (equal (ids) '("three"))))))))

(ert-deftest sub-buffer-org-save-queue ()
  "Saving an unnamed queue with write-file keeps it playable."
  (let* ((sub-buffer-use-org t)
         (sub-buffer-server "https://example.test/music/")
         (directory (make-temp-file "sub-buffer-save-" t))
         (sub-buffer-playlist-directory (expand-file-name "playlists/" directory))
         (queue (generate-new-buffer " *org-save-queue*")))
    (unwind-protect
        (save-window-excursion
          (with-current-buffer queue
            (sub-buffer-org-mode)
            (sub-buffer--insert-songs '(((id . "one") (title . "Piece"))))
            (write-file (expand-file-name "saved.org" sub-buffer-playlist-directory))
            (should (eq major-mode 'sub-buffer-org-mode))
            (goto-char (point-min))
            (re-search-forward "^- ")
            (should (equal (alist-get 'id (cdr (sub-buffer--entry))) "one"))))
      (when (buffer-live-p queue)
        (with-current-buffer queue (set-buffer-modified-p nil))
        (kill-buffer queue))
      (delete-directory directory t))))

(ert-deftest sub-buffer-org-playlists ()
  "Use saved Org files as queues, without searching again on reopen."
  (let* ((sub-buffer-use-org t)
         (directory (make-temp-file "sub-buffer-playlists-" t))
         (sub-buffer-playlist-directory (expand-file-name "playlists/" directory))
         (sub-buffer-server "https://example.test/music/")
         (first '((id . "a/b ?#[]%é") (title . "Piece ]] [live]")))
         (second '((id . "two") (title . "Final")))
         (file (expand-file-name "evening.org" sub-buffer-playlist-directory))
         queue)
    (cl-labels ((ids ()
                 (save-excursion
                   (goto-char (point-min))
                   (let (result)
                     (while (not (eobp))
                       (when-let* ((entry (sub-buffer--entry)))
                         (push (alist-get 'id (cdr entry)) result))
                       (forward-line 1))
                     (nreverse result)))))
      (unwind-protect
          (save-window-excursion
            (sub-buffer-open-playlist "evening")
            (setq queue (current-buffer))
            (should (derived-mode-p 'sub-buffer-org-mode 'org-mode))
            (sub-buffer--insert-songs (list first second first))
            (insert "unfinished search\n\n* Notes\n"
                    "# [[sub-buffer:comment][Ignore]]\n"
                    "#+begin_src text\n[[sub-buffer:code][Ignore]]\n#+end_src\n")
            (should (string-match-p (regexp-quote "a%2Fb%20%3F%23%5B%5D%25%C3%A9")
                                    (buffer-string)))
            (save-buffer)
            (kill-buffer queue)
            (cl-letf (((symbol-function 'sub-buffer--request)
                       (lambda (&rest _) (ert-fail "Reopening must not contact the server"))))
              (find-file file)
              (setq queue (current-buffer))
              (should (eq major-mode 'sub-buffer-org-mode))
              (should (eq (key-binding (kbd "C-c C-o")) #'org-open-at-point))
              (should (equal (ids) (list (alist-get 'id first) "two" (alist-get 'id first))))
              (should-not (buffer-modified-p))
              ;; Native Org moves keep the playing entry's identity.
              (goto-char (point-min))
              (re-search-forward "^- ")
              (beginning-of-line)
              (setq sub-buffer--current (sub-buffer--entry)
                    sub-buffer--position (copy-marker (point) t))
              (let ((entry sub-buffer--current))
                (org-metadown)
                (should (eq entry (sub-buffer--entry)))
                (should (= (line-beginning-position) (sub-buffer--current-line))))
              (should (equal (ids) (list "two" (alist-get 'id first) (alist-get 'id first))))
              (cl-letf (((symbol-function 'sub-buffer-play)
                         (lambda ()
                           (setq sub-buffer--current (sub-buffer--entry)
                                 sub-buffer--position (copy-marker (line-beginning-position) t)))))
                (goto-char (point-min))
                (re-search-forward "\\[\\[sub-buffer:two")
                (org-open-at-point)
                (should (equal (alist-get 'id (cdr sub-buffer--current)) "two"))
                (sub-buffer-next)
                (let ((entry sub-buffer--current))
                  (sub-buffer-next)
                  (should-not (eq entry sub-buffer--current))
                  (should (equal (alist-get 'id (cdr sub-buffer--current))
                                 (alist-get 'id first)))
                  (sub-buffer-previous)
                  (should (eq entry sub-buffer--current)))))
            ;; Missing album metadata is fetched only when the user asks for it.
            (goto-char (sub-buffer--current-line))
            (cl-letf (((symbol-function 'sub-buffer--request)
                       (lambda (endpoint parameters)
                         (pcase endpoint
                           ("getSong"
                            (should (equal (cdr (assoc "id" parameters)) (alist-get 'id first)))
                            '((song . ((albumId . "album")))))
                           ("getAlbum" '((album . ((id . "album")))))))))
              (should (equal (alist-get 'id (sub-buffer--album-at-point)) "album")))
            (let ((sub-buffer-server "https://other.test"))
              (should-error (sub-buffer-play) :type 'user-error))
            ;; Editing detaches the ID in the file, and completion skips the bullet.
            (sub-buffer-edit)
            (should-not (sub-buffer--entry))
            (delete-region (sub-buffer--line-start) (line-end-position))
            (insert "Final")
            (cl-letf (((symbol-function 'sub-buffer--search)
                       (lambda (query)
                         (should (equal query "Final"))
                         (sub-buffer--candidates (list second)))))
              (completion-at-point))
            (should (equal (alist-get 'id (cdr (sub-buffer--entry))) "two"))
            ;; A manually changed ID wins over stale text properties.
            (beginning-of-line)
            (search-forward "sub-buffer:two")
            (replace-match "sub-buffer:changed" t t)
            (should (equal (alist-get 'id (cdr (sub-buffer--entry))) "changed"))
            (save-buffer)
            (kill-buffer queue)
            (let ((sub-buffer-use-org nil))
              (find-file file)
              (setq queue (current-buffer))
              (should (eq major-mode 'org-mode))))
        (when (buffer-live-p queue)
          (with-current-buffer queue (set-buffer-modified-p nil))
          (kill-buffer queue))
        (delete-directory directory t)))))

(ert-deftest sub-buffer-org-server-binding ()
  "Bind inserted tracks to their server and reject unbound playback."
  (require 'sub-buffer-org)
  (let ((sub-buffer-server "https://example.test/music/"))
    (with-temp-buffer
      (insert "- query\n")
      (sub-buffer-org-mode)
      (goto-char (point-min))
      (let ((text (buffer-string)))
        (should (string-match-p "SUB_BUFFER_SERVER"
                                (error-message-string
                                 (should-error (sub-buffer-play) :type 'user-error))))
        (should (equal text (buffer-string)))
        (let ((sub-buffer-server nil))
          (should-error (sub-buffer--insert-songs '(((id . "one"))) t) :type 'user-error))
        (should (equal text (buffer-string))))
      (sub-buffer--insert-songs '(((id . "one"))) t)
      (goto-char (point-min))
      (should (looking-at (regexp-quote "#+SUB_BUFFER_SERVER: https://example.test/music/\n")))
      (forward-line 1)
      (should (equal (alist-get 'id (cdr (sub-buffer--entry))) "one"))
      (let ((text (buffer-string))
            (sub-buffer-server "https://other.test"))
        (should-error (sub-buffer--insert-songs '(((id . "two")))) :type 'user-error)
        (should (equal text (buffer-string))))
      (let ((sub-buffer-server "https://example.test/music"))
        (sub-buffer-org--check-server)))))

(ert-deftest sub-buffer-org-nested-collection ()
  "Keep expanded tracks in their numbered, nested checkbox list."
  (require 'sub-buffer-org)
  (let ((sub-buffer-server "https://example.test"))
    (with-temp-buffer
      (insert "* Set\n- Parent\n  1. [ ] query\n- Sibling\n")
      (sub-buffer-org-mode)
      (goto-char (point-min))
      (forward-line 2)
      (sub-buffer--insert-songs '(((id . "one")) ((id . "two"))) t)
      (goto-char (point-min))
      (forward-line 3)
      (should (looking-at "  1\\. \\[ \\] "))
      (should (equal (alist-get 'id (cdr (sub-buffer--entry))) "one"))
      (forward-line 1)
      (should (looking-at "  2\\. \\[ \\] "))
      (should (equal (alist-get 'id (cdr (sub-buffer--entry))) "two"))
      (forward-line 1)
      (should (looking-at "  3\\. \\[ \\] "))
      (should-not (sub-buffer--entry)))))

